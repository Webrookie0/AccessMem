# AccessMem local configuration
APP_ENV=development
DEMO_USERS_ENABLED=true

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_TIMEOUT=120
OLLAMA_EMBED_TIMEOUT=60
EMBEDDING_BATCH_SIZE=32

# Run python -m app.bootstrap to create .env with a random secret.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=accessmem
JWT_AUDIENCE=accessmem-api
JWT_EXPIRE_MINUTES=60
USER_DATABASE_PATH=./accessmem_users.db

# Storage
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=secure_docs
AUDIT_LOG_PATH=./audit.log
AUDIT_LOG_MAX_BYTES=5000000
AUDIT_LOG_BACKUP_COUNT=3
AUDIT_LOG_QUESTIONS=false

# Retrieval
RETRIEVAL_MODE=hybrid
TOP_K=4
RETRIEVAL_CANDIDATES=20
RRF_RANK_CONSTANT=60
MINIMUM_SIMILARITY=0.2

# Ingestion
CHUNK_CHARS=800
CHUNK_OVERLAP=100
INGEST_CORPUS_ID=seed

# API and UI
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
LOGIN_REQUESTS_PER_MINUTE=10
CHAT_REQUESTS_PER_MINUTE=30
API_BASE_URL=http://localhost:8000
API_TIMEOUT=200

# Offline RAGAS evaluation through Ollama's OpenAI-compatible endpoint
RAGAS_BASE_URL=http://localhost:11434/v1
RAGAS_MODEL=qwen2.5-coder:7b
RAGAS_EMBED_MODEL=nomic-embed-text
RAGAS_API_KEY=ollama
RAGAS_TIMEOUT=120
